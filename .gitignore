# ---- 运行环境（太大，绝不上传）----
runtime/
jfx/
tools/
target/

# ---- 构建产物（由 build.ps1 重新生成，绝不入库；发布走 GitHub Release 或本地构建）----
out/
*.class
shot.log
shotb.log
app/FlashWriteFx.jar
闪写.exe

# build 目录只保留打包必需的 launch4j.xml / manifest.txt / icon.ico，其余全是测试日志
build/*
!build/launch4j.xml
!build/manifest.txt
!build/icon.ico
!build/ico/

# ---- 用户数据 / 日志（含个人文档，严禁上传）----
data/

# ---- 测试截图与临时输出 ----
ui_*.png
test/*.log
test/*.out
test/*.png
test/app.js

# ---- 系统杂项 ----
Thumbs.db
Desktop.ini
*.lock

# ---- 本机工作区状态与发行目录（.vscode/、.idea/ 静态配置入库共享）----
dist/
*.lnk
.idea/workspace.xml
.idea/shelf/
.idea/httpRequests/
