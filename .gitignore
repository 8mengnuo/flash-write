# ---- 运行环境（太大，绝不上传）----
runtime/
jfx/
tools/
target/

# ---- 构建产物（由 build.ps1 重新生成，绝不入库；发布走 GitHub Release 或本地构建）----
out/
*.class
shot.log
shotb.log
app/FlashWriteFx.jar
闪写.exe

# build 目录只保留打包必需的 launch4j.xml / manifest.txt / icon.ico，其余全是测试日志
build/*
!build/launch4j.xml
!build/manifest.txt
!build/icon.ico
!build/ico/

# ---- 用户数据 / 日志（含个人文档，严禁上传）----
data/

# ---- 测试截图与临时输出 ----
ui_*.png
test/*.log
test/*.out
test/*.png
test/app.js

# ---- 系统杂项 ----
Thumbs.db
Desktop.ini
*.lock

# ---- 仅本地参考、不入库的开发文档 ----
docs/闪写实现逻辑与选型参考.md

# ---- 本机工作区状态与发行目录（.vscode/、.idea/ 静态配置入库共享）----
dist/
*.lnk

# ---- 发行压缩包（本地打包、由用户自行上传 Release，不入库）----
# 压缩包实际生成在工作区上级目录，本就不在仓库内；此规则防止误拷入仓库被提交
*.zip
闪写 FlashWrite v*.zip
.idea/workspace.xml
.idea/shelf/
.idea/httpRequests/
